{
  "name": "codecrafterx_portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "start:api": "tsx server/index.ts",
    "build": "prisma generate && tsc -b && vite build",
    "test": "node --import tsx --test server/*.test.ts",
    "check": "npm run test && npm run build",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.35.0",
    "@clerk/express": "^1.7.31",
    "@emailjs/browser": "^4.4.1",
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-three/drei": "^10.5.1",
    "@react-three/fiber": "^9.2.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.1.11",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "gsap": "^3.13.0",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.1.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.1.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.9.3",
    "tailwindcss": "^4.1.11",
    "three": "^0.178.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/express": "^4.17.23",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.8.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "prisma": "^7.8.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
  }
}
