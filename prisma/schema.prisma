generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  category        String
  description     String
  longDescription String  @map("longdescription")
  challenge       String
  solution        String
  results         String[]
  techStack       String[] @map("techstack")
  images          String[]
  liveUrl         String?  @map("liveurl")
  features        String[]
  bgColor         String?  @map("bgcolor")
  featured        Boolean  @default(false)
  published       Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sortorder")
  createdAt       DateTime @default(now()) @map("createdat")
  updatedAt       DateTime @updatedAt @map("updatedat")

  @@map("Project")
}
